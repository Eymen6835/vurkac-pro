{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "redis",
      "runtimeExecutable": "python",
      "runtimeArgs": ["backend/redis_server.py"],
      "port": 6379
    },
    {
      "name": "backend",
      "runtimeExecutable": "py",
      "runtimeArgs": ["-3.12", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--app-dir", "backend/app"],
      "port": 8000,
      "autoPort": false
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["next", "dev", "-p", "3005"],
      "port": 3005,
      "autoPort": false
    }
  ]
}
